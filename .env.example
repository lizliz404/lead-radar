# Reddit API credentials (required for real data)
# Get these from https://www.reddit.com/prefs/apps
# Create a "script" type app. Client ID and Secret are shown on the app page.
# User agent should be descriptive: "<app-name>/<version> by <reddit-username>"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="lead-radar/0.1 by your_reddit_username"

# Optional: pre-fetched access token (auto-refresh works without this)
# REDDIT_ACCESS_TOKEN=

# LLM provider (required for LLM report generation)
# Default works with OpenRouter. Adjust for OpenAI, Anthropic, etc.
LEAD_RADAR_LLM_API_KEY=
LEAD_RADAR_LLM_BASE_URL=https://openrouter.ai/api/v1
LEAD_RADAR_LLM_MODEL=openai/gpt-4o-mini

# Optional: public landing deployment
# Used by static metadata, sitemap, and links that expose the private operator console.
NEXT_PUBLIC_SITE_URL=https://lead-radar.lizliz.xyz
# Keep empty until Streamlit is deployed behind auth or a private URL.
# Recommended public shape: https://app.lead-radar.lizliz.xyz
NEXT_PUBLIC_OPERATOR_APP_URL=

# Optional: notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FEISHU_WEBHOOK_URL=

# Optional: data paths
# LEAD_RADAR_DB_PATH=data/lead_radar.sqlite
