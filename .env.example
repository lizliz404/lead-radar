# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="lead-radar/0.1 by your_reddit_username"

# Optional: use an existing bearer token instead of client_id/client_secret exchange.
# Reddit access tokens expire, so client_id/client_secret is usually more stable.
REDDIT_ACCESS_TOKEN=

# Optional Feishu custom bot webhook
FEISHU_WEBHOOK_URL=

# Optional Telegram bot notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional OpenAI-compatible LLM reranker
LEAD_RADAR_LLM_API_KEY=
LEAD_RADAR_LLM_BASE_URL=
LEAD_RADAR_LLM_MODEL=

# Optional storage path
LEAD_RADAR_DB_PATH=data/lead_radar.sqlite
